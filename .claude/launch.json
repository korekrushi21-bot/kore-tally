{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kore-tally-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8123"
      ],
      "port": 8123
    },
    {
      "name": "overdue-reminder",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tally-overdue-reminder/backend/server.js"
      ],
      "port": 4000
    },
    {
      "name": "kore-ai",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "my-ai/server.js"
      ],
      "port": 3000
    },
    {
      "name": "upstox-backend",
      "runtimeExecutable": "upstox-ai-trader/backend/.venv/Scripts/uvicorn.exe",
      "runtimeArgs": [
        "app.main:app",
        "--app-dir",
        "upstox-ai-trader/backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8010"
      ],
      "port": 8010
    },
    {
      "name": "upstox-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "upstox-ai-trader/dashboard",
        "run",
        "dev"
      ],
      "port": 5180
    }
  ]
}