# ---- Server ----
PORT=8787
NODE_ENV=development
DATABASE_PATH=./data/jarvis.db

# ---- Auth (REQUIRED) ----
# Long random string (32+ chars):  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# The code you type once into the app (Settings -> AI). 8+ chars. Treat it like a password.
APP_ACCESS_CODE=
# Admin panel (/admin). Generate hash:  npm run hash -- "your password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ---- AI brain ----
AI_PROVIDER=openai            # openai | anthropic | custom
AI_API_KEY=                   # OpenAI key (or key for the custom OpenAI-compatible server)
AI_MODEL=                     # blank = provider default (gpt-4o-mini / claude-sonnet-5-5)
ANTHROPIC_API_KEY=            # only if using Anthropic (falls back to AI_API_KEY)
AI_BASE_URL=                  # custom provider only, e.g. https://my-llm.example.com/v1
VISION_MODEL=                 # optional: separate model for crop photo analysis

# ---- Web search / news (Tavily) ----
SEARCH_API_KEY=

# ---- Reserved for optional cloud voice (the app uses on-device iOS STT/TTS by default) ----
TTS_API_KEY=
STT_API_KEY=

# Native apps do not need CORS. Only set if you host a web client.
CORS_ORIGINS=
