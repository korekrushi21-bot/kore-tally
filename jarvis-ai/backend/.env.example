# ---- Server ----
PORT=8787
NODE_ENV=development
DATABASE_PATH=./data/jarvis.db

# ---- Auth (REQUIRED) ----
# Long random string (32+ chars):  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# The code you type once into the app (Settings -> AI). 8+ chars. Treat it like a password.
APP_ACCESS_CODE=
# Admin panel (/admin). Generate hash:  npm run hash -- "your password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ---- AI brain: LOCAL by default (free, no API key) ----
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Leave blank to auto-pick a lightweight installed model, or set e.g. qwen2.5:3b / gemma3:4b / llama3.2:3b
AI_MODEL=
# Optional vision model for crop photos (blank = auto-pick an installed vision-capable model)
VISION_MODEL=

# ---- OPTIONAL cloud AI (NOT required). Leave all of these empty to stay 100% free/local. ----
# Optional fallback if Ollama is unreachable:  openai | anthropic | custom
AI_FALLBACK_PROVIDER=
AI_API_KEY=                   # OpenAI key, or key for a custom OpenAI-compatible service (paid or free tier, your choice)
ANTHROPIC_API_KEY=
AI_BASE_URL=                  # custom OpenAI-compatible endpoint (e.g. a free-tier host such as Groq/OpenRouter/Gemini; check their current limits)

# ---- Web search (all optional; the free chain works with none of these) ----
# Free chain with no setup: Google News RSS (headlines) + Wikipedia (background).
# Better real web search, still free: self-hosted SearXNG (JSON format enabled):
SEARXNG_URL=
# Or Tavily (has a free tier but needs a free account key):
SEARCH_API_KEY=

# ---- Reserved: optional cloud voice. The app uses free on-device system STT/TTS by default. ----
TTS_API_KEY=
STT_API_KEY=

# Native apps do not need CORS. Set for the desktop web app origin, e.g. http://localhost:8081
CORS_ORIGINS=
