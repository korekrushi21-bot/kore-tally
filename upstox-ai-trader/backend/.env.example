# Copy this file to .env and fill in real values. Never commit .env.

APP_ENV=development

# From your app registered at https://account.upstox.com/developer/apps
UPSTOX_CLIENT_ID=your_upstox_api_key
UPSTOX_CLIENT_SECRET=your_upstox_api_secret
# Must exactly match the redirect URI registered on the Upstox developer dashboard.
UPSTOX_REDIRECT_URI=http://localhost:8010/auth/callback
UPSTOX_API_BASE=https://api.upstox.com

# Postgres in docker-compose; swap for sqlite:///./upstox_trader.db for a zero-setup local run.
DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5432/upstox_trader

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace_with_generated_fernet_key

# Any long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=replace_with_random_string

CORS_ALLOW_ORIGINS=["http://localhost:8010","http://localhost:5180"]

# --- Paper trading + risk engine (Phase 2) ---
# These are enforced server-side by app/engine/risk.py, not just UI defaults.
PAPER_TRADING_STARTING_CAPITAL=100000.0
RISK_MAX_PER_TRADE_PCT=0.005
RISK_MAX_DAILY_LOSS_PCT=0.015
RISK_MAX_OPEN_POSITIONS=3
RISK_MIN_REWARD_RATIO=2.0
RISK_ALLOW_AVERAGING_DOWN=false

# Approximate cost model for paper P&L only — see app/engine/costs.py.
COST_BROKERAGE_PER_ORDER=20.0
COST_PCT_CHARGES=0.001
SLIPPAGE_BPS=5.0

# --- Live trading (Phase 5) — REAL MONEY, REAL ORDERS ---
# Stays false until you've read the "Live trading" section of README.md in full,
# including the Upstox/SEBI prerequisites (registered static IP, order-rate limits).
# Cannot be turned on from the API or dashboard — .env + a backend restart only.
LIVE_TRADING_ENABLED=false
# "I" = intraday. The only product type exit_all_positions() can flatten via the API.
LIVE_ORDER_PRODUCT=I
# Only set this if you've registered this app as an Algo App on Upstox's developer
# console and been given an Algo Name — see README. Leave blank otherwise.
UPSTOX_ALGO_NAME=
LIVE_DUPLICATE_GUARD_SECONDS=10
LIVE_ENTRY_FILL_POLL_ATTEMPTS=5
LIVE_ENTRY_FILL_POLL_INTERVAL_SECONDS=1.0
# Must be sent exactly as the "confirm" field to POST /live/stop-all.
LIVE_STOP_ALL_CONFIRMATION_PHRASE=STOP ALL LIVE TRADING
